#!/bin/bash
# Join script: publish the editors through the UCS Apache on /sheets, /docs and /hosting (one origin for Nextcloud).
VERSION=1
. /usr/share/univention-join/joinscripthelper.lib
joinscript_init

cat >/etc/apache2/conf-available/sumoffice.conf <<'EOF'
# SumOffice editors (SumSheet /sheets, SumDoc /docs, WOPI discovery /hosting) on 127.0.0.1:8093.
# Needs Apache >= 2.4.47 (upgrade=websocket), i.e. UCS 5.2. ProxyPass in the server config is inherited
# by the UCS virtual hosts (ProxyPassInherit is on by default).
<IfModule mod_proxy.c>
  ProxyPreserveHost On
  ProxyTimeout 3600
  RequestHeader set X-Forwarded-Proto "https" env=HTTPS
  ProxyPass /sheets http://127.0.0.1:8093/sheets upgrade=websocket retry=0
  ProxyPassReverse /sheets http://127.0.0.1:8093/sheets
  ProxyPass /docs http://127.0.0.1:8093/docs upgrade=websocket retry=0
  ProxyPassReverse /docs http://127.0.0.1:8093/docs
  ProxyPass /hosting http://127.0.0.1:8093/hosting retry=0
  ProxyPassReverse /hosting http://127.0.0.1:8093/hosting
</IfModule>
EOF
a2enmod -q proxy proxy_http proxy_wstunnel headers || die
a2enconf -q sumoffice || die
systemctl reload apache2 || die

joinscript_save_current_version
exit 0
