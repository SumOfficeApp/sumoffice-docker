#!/bin/bash
# Unjoin script: remove the Apache proxy of the SumOffice editors.
VERSION=1
. /usr/share/univention-join/joinscripthelper.lib
joinscript_init

a2disconf -q sumoffice || true
rm -f /etc/apache2/conf-available/sumoffice.conf
systemctl reload apache2 || true

joinscript_remove_script_from_status_file sumoffice
exit 0
