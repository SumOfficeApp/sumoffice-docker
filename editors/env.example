# PUBLIC_URL    — the address this stack is reachable at; you give the same one to the host.
# WOPI_HOST_URL — your WOPI host (EspoCRM or another system), with the scheme.
# WOPI_HOST — the hostname only: no scheme and NO PORT. With a port it will not match
#                  the allow-list, and opening a file answers 403.
PUBLIC_URL=https://office.example.com
WOPI_HOST_URL=https://crm.example.com
WOPI_HOST=crm.example.com
