# PUBLIC_URL     — the address of this front; Nextcloud Office's wopi_url and public_wopi_url.
# COLLABORA_URL  — where this stack reaches your Collabora (container name, LAN address or https URL).
# NEXTCLOUD_HOST — Nextcloud's hostname only (no scheme, no port), as Collabora/SumSheet call it back.
PUBLIC_URL=https://office.example.com
COLLABORA_URL=https://collabora.example.com
COLLABORA_HOST_HEADER=collabora.example.com
NEXTCLOUD_HOST=cloud.example.com
