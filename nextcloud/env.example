# PUBLIC_URL    — the address this stack is reachable at; you give the same one to the host.
# NEXTCLOUD_URL — your Nextcloud, with the scheme.
# NEXTCLOUD_HOST — the hostname only: no scheme and NO PORT. With a port it will not match
#                  the allow-list, and opening a file answers 403.
PUBLIC_URL=https://office.example.com
NEXTCLOUD_URL=https://cloud.example.com
NEXTCLOUD_HOST=cloud.example.com
