<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="mail.AttachmentList" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o-mail-AttachmentButtons')]" position="inside">
            <a t-if="canOpenInSumOffice(attachment)"
               class="o-sumoffice-open btn bg-500 w-100 h-100 o-p-1_5 d-flex justify-content-center align-items-center shadow-sm"
               t-att-href="sumOfficeUrl(attachment)" target="_blank" title="Open in SumOffice"
               t-on-click.stop="() => {}">
                <i class="fa fa-pencil-square-o o-text-white" role="img" aria-label="Open in SumOffice"/>
            </a>
        </xpath>
    </t>
</templates>
