<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_sumoffice" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.sumoffice</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="SumOffice" name="sumoffice_wopi">
                    <block title="SumOffice" name="sumoffice_setting_container">
                        <setting string="Discovery URL" help="Where SumOffice publishes its WOPI discovery">
                            <field name="sumoffice_discovery_url" placeholder="https://office.example.com/hosting/discovery"/>
                        </setting>
                        <setting string="Verify proof keys" help="Reject WOPI calls that SumOffice did not sign">
                            <field name="sumoffice_verify_proof"/>
                        </setting>
                        <setting string="CA bundle" help="Only for a private certificate on the SumOffice side">
                            <field name="sumoffice_ca_bundle"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
